// ── main app ─────────────────────────────────────────────────────────
export default function App() {
  const [companies, setCompanies] = useState([]);
  const [rawCount, setRawCount] = useState(0);
  const [fileName, setFileName] = useState("");
  const [isDragging, setIsDragging] = useState(false);
  const [expandedId, setExpandedId] = useState(null);
  const [search, setSearch] = useState("");
  const [tierFilter, setTierFilter] = useState("all");
  const [provinceFilter, setProvinceFilter] = useState("all");
  const [categoryFilter, setCategoryFilter] = useState("all");
  const [sortBy, setSortBy] = useState("score");
  const fileRef = useRef(null);

  const handleFile = useCallback((file) => {
    if (!file) return;
    setFileName(file.name);
    const reader = new FileReader();
    reader.onload = (e) => {
      const text = e.target.result;
      const rawRows = parseCSV(text);
      setRawCount(rawRows.length);
      const processed = processRows(rawRows);
      setCompanies(processed);
      setExpandedId(null);
      setSearch("");
      setTierFilter("all");
      setProvinceFilter("all");
      setCategoryFilter("all");
    };
    reader.readAsText(file, "utf-8");
  }, []);

  const onDrop = useCallback((e) => {
    e.preventDefault();
    setIsDragging(false);
    const file = e.dataTransfer.files[0];
    if (file && file.name.endsWith(".csv")) handleFile(file);
  }, [handleFile]);

  const provinces = useMemo(() => {
    const set = new Set(companies.map(c => c.province).filter(Boolean));
    return Array.from(set).sort();
  }, [companies]);

  const categories = useMemo(() => {
    const set = new Set(companies.map(c => c.category).filter(Boolean));
    return Array.from(set).sort();
  }, [companies]);

  const filtered = useMemo(() => {
    let list = companies;
    if (tierFilter !== "all") list = list.filter(c => c.tier === tierFilter);
    if (provinceFilter !== "all") list = list.filter(c => c.province === provinceFilter);
    if (categoryFilter !== "all") list = list.filter(c => c.category === categoryFilter);
    if (search) {
      const s = search.toLowerCase();
      list = list.filter(c =>
        c.name.toLowerCase().includes(s) ||
        c.city.toLowerCase().includes(s) ||
        c.contracts.some(ct => ct.entity.toLowerCase().includes(s))
      );
    }
    list = [...list].sort((a, b) => {
      if (sortBy === "score") return b.score - a.score;
      if (sortBy === "amount") return b.totalAmount - a.totalAmount;
      if (sortBy === "name") return a.name.localeCompare(b.name);
      if (sortBy === "contracts") return b.contractCount - a.contractCount;
      return 0;
    });
    return list;
  }, [companies, tierFilter, provinceFilter, categoryFilter, search, sortBy]);

  const stats = useMemo(() => {
    if (!companies.length) return null;
    return {
      total: companies.length,
      high: companies.filter(c => c.tier === "high").length,
      medium: companies.filter(c => c.tier === "medium").length,
      low: companies.filter(c => c.tier === "low").length,
      totalValue: companies.reduce((s, c) => s + c.totalAmount, 0),
      canadian: companies.filter(c => isCanadian(c.country)).length,
    };
  }, [companies]);

  const exportCSV = useCallback(() => {
    const header = ["Company", "City", "Province", "Category", "ICP Score", "ICP Tier", "Total Amount", "Contracts", "Contracting Entities", "LinkedIn Champions", "LinkedIn Decision Makers", "LinkedIn Company", "Google Website", "Google Contact", "Google Procurement"];
    const rows = filtered.map(c => {
      const championTitles = getChampionTitles(c.category);
      return [
        c.name,
        c.city,
        c.province,
        c.category,
        c.score,
        c.tier,
        c.totalAmount,
        c.contractCount,
        c.contracts.map(ct => ct.entity).join("; "),
        buildLinkedInPeopleSearch(c.name, championTitles),
        buildLinkedInPeopleSearch(c.name, DECISION_TITLES),
        buildLinkedInCompanySearch(c.name),
        buildGoogleWebsiteSearch(c.name, c.city),
        buildGoogleContactSearch(c.name, c.city, c.province),
        buildGoogleProcurementSearch(c.name),
      ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(",");
    });
    const csv = [header.join(","), ...rows].join("\n");
    const blob = new Blob([csv], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `awardly-leads-${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }, [filtered]);

  // ── styles ──
  const selectStyle = {
    background: "rgba(255,255,255,0.05)",
    border: "1px solid rgba(255,255,255,0.1)",
    borderRadius: 6,
    color: "#e2e8f0",
    padding: "6px 10px",
    fontSize: 12,
    outline: "none",
    cursor: "pointer",
    minWidth: 100,
  };

  return (
    <div style={{
      fontFamily: "'Poppins', 'Segoe UI', sans-serif",
      background: "linear-gradient(165deg, #070d1b 0%, #0c1428 40%, #0f1832 100%)",
      minHeight: "100vh",
      color: "#e2e8f0",
      padding: 0,
    }}>
      <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />

      {/* Header */}
      <div style={{
        background: "linear-gradient(135deg, #144593 0%, #0c2d66 100%)",
        borderBottom: "1px solid rgba(18,217,249,0.2)",
        padding: "20px 24px",
      }}>
        <div style={{ display: "flex", alignItems: "center", justifyContent: "space-between", maxWidth: 900, margin: "0 auto" }}>
          <div>
            <h1 style={{
              fontSize: 20,
              fontWeight: 700,
              margin: 0,
              background: "linear-gradient(135deg, #ffffff 0%, #12D9F9 100%)",
              WebkitBackgroundClip: "text",
              WebkitTextFillColor: "transparent",
              letterSpacing: "-0.02em",
            }}>
              Lead Intelligence Tool
            </h1>
            <p style={{ color: "rgba(255,255,255,0.5)", fontSize: 12, margin: "4px 0 0" }}>
              Drop a CanadaBuys award CSV. Get a scored, searchable prospect list.
            </p>
          </div>
          <div style={{
            color: "#12D9F9",
            fontSize: 24,
            fontWeight: 700,
            fontStyle: "italic",
            letterSpacing: "-0.03em",
            opacity: 0.7,
          }}>
            awardly
          </div>
        </div>
      </div>

      <div style={{ maxWidth: 900, margin: "0 auto", padding: "20px 16px" }}>
        {/* Upload zone */}
        {companies.length === 0 ? (
          <div
            onDragOver={(e) => { e.preventDefault(); setIsDragging(true); }}
            onDragLeave={() => setIsDragging(false)}
            onDrop={onDrop}
            onClick={() => fileRef.current?.click()}
            style={{
              border: `2px dashed ${isDragging ? "#12D9F9" : "rgba(255,255,255,0.15)"}`,
              borderRadius: 14,
              padding: "60px 40px",
              textAlign: "center",
              cursor: "pointer",
              background: isDragging ? "rgba(18,217,249,0.05)" : "rgba(255,255,255,0.02)",
              transition: "all 0.2s",
            }}
          >
            <input
              ref={fileRef}
              type="file"
              accept=".csv"
              style={{ display: "none" }}
              onChange={(e) => handleFile(e.target.files[0])}
            />
            <div style={{ fontSize: 40, marginBottom: 12, opacity: 0.6 }}>📂</div>
            <div style={{ color: "#f1f5f9", fontSize: 16, fontWeight: 600 }}>
              Drop a CanadaBuys CSV here
            </div>
            <div style={{ color: "#64748b", fontSize: 13, marginTop: 6 }}>
              Award notices, tender notices, or any dataset with supplier information
            </div>
            <div style={{ color: "#475569", fontSize: 11, marginTop: 16 }}>
              Supports: awardNotice, tenderNotice CSV exports from CanadaBuys / PSPC
            </div>
          </div>
        ) : (
          <>
            {/* Stats bar */}
            {stats && (
              <div style={{
                display: "grid",
                gridTemplateColumns: "repeat(auto-fit, minmax(120px, 1fr))",
                gap: 8,
                marginBottom: 16,
              }}>
                {[
                  { label: "Companies", value: stats.total, sub: `from ${rawCount} rows` },
                  { label: "High Fit", value: stats.high, color: "#4ade80" },
                  { label: "Medium Fit", value: stats.medium, color: "#facc15" },
                  { label: "Low Fit", value: stats.low, color: "#f87171" },
                  { label: "Total Value", value: `$${(stats.totalValue / 1000000).toFixed(1)}M` },
                  { label: "Canadian", value: stats.canadian },
                ].map((s, i) => (
                  <div key={i} style={{
                    background: "rgba(255,255,255,0.03)",
                    border: "1px solid rgba(255,255,255,0.06)",
                    borderRadius: 8,
                    padding: "10px 12px",
                    textAlign: "center",
                  }}>
                    <div style={{ color: s.color || "#f1f5f9", fontSize: 20, fontWeight: 700 }}>{s.value}</div>
                    <div style={{ color: "#64748b", fontSize: 10, fontWeight: 500, textTransform: "uppercase", letterSpacing: "0.04em" }}>{s.label}</div>
                    {s.sub && <div style={{ color: "#475569", fontSize: 9, marginTop: 2 }}>{s.sub}</div>}
                  </div>
                ))}
              </div>
            )}

            {/* Filters */}
            <div style={{
              display: "flex",
              flexWrap: "wrap",
              gap: 8,
              alignItems: "center",
              marginBottom: 14,
              padding: "10px 14px",
              background: "rgba(255,255,255,0.02)",
              borderRadius: 10,
              border: "1px solid rgba(255,255,255,0.06)",
            }}>
              <input
                type="text"
                placeholder="Search companies, cities, entities..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                style={{
                  ...selectStyle,
                  flex: 1,
                  minWidth: 180,
                }}
              />
              <select value={tierFilter} onChange={(e) => setTierFilter(e.target.value)} style={selectStyle}>
                <option value="all">All tiers</option>
                <option value="high">High fit</option>
                <option value="medium">Medium fit</option>
                <option value="low">Low fit</option>
              </select>
              <select value={provinceFilter} onChange={(e) => setProvinceFilter(e.target.value)} style={selectStyle}>
                <option value="all">All provinces</option>
                {provinces.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
              <select value={categoryFilter} onChange={(e) => setCategoryFilter(e.target.value)} style={selectStyle}>
                <option value="all">All categories</option>
                {categories.map(c => <option key={c} value={c}>{c.replace("_", " + ")}</option>)}
              </select>
              <select value={sortBy} onChange={(e) => setSortBy(e.target.value)} style={selectStyle}>
                <option value="score">Sort: ICP Score</option>
                <option value="amount">Sort: Amount</option>
                <option value="name">Sort: Name</option>
                <option value="contracts">Sort: # Contracts</option>
              </select>
            </div>

            {/* Action bar */}
            <div style={{
              display: "flex",
              justifyContent: "space-between",
              alignItems: "center",
              marginBottom: 12,
            }}>
              <span style={{ color: "#64748b", fontSize: 12 }}>
                Showing {filtered.length} of {companies.length} companies
              </span>
              <div style={{ display: "flex", gap: 8 }}>
                <button
                  onClick={exportCSV}
                  style={{
                    padding: "6px 14px",
                    borderRadius: 6,
                    background: "rgba(18,217,249,0.12)",
                    border: "1px solid rgba(18,217,249,0.3)",
                    color: "#12D9F9",
                    fontSize: 12,
                    fontWeight: 600,
                    cursor: "pointer",
                  }}
                >
                  Export CSV with search links
                </button>
                <button
                  onClick={() => {
                    setCompanies([]);
                    setFileName("");
                    setRawCount(0);
                  }}
                  style={{
                    padding: "6px 14px",
                    borderRadius: 6,
                    background: "rgba(255,255,255,0.05)",
                    border: "1px solid rgba(255,255,255,0.1)",
                    color: "#94a3b8",
                    fontSize: 12,
                    fontWeight: 500,
                    cursor: "pointer",
                  }}
                >
                  New upload
                </button>
              </div>
            </div>

            {/* Company list */}
            <div>
              {filtered.map(company => (
                <CompanyCard
                  key={company.id}
                  company={company}
                  isExpanded={expandedId === company.id}
                  onToggle={() => setExpandedId(expandedId === company.id ? null : company.id)}
                />
              ))}
              {filtered.length === 0 && (
                <div style={{ textAlign: "center", padding: 40, color: "#475569" }}>
                  No companies match your filters.
                </div>
              )}
            </div>
          </>
        )}
      </div>
    </div>
  );
}
