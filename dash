import { useState, useMemo, useCallback, useRef } from "react";

// ── helpers ──────────────────────────────────────────────────────────
const CANADIAN_COUNTRIES = ["ca", "canada"];
const EXCLUDE_KEYWORDS = [
  "university", "college", "institut", "school", "hospital",
  "health authority", "city of", "province of", "government",
  "municipality", "crown", "nation of", "first nation",
];
const LARGE_CORP_KEYWORDS = [
  "deloitte", "kpmg", "pwc", "ernst", "mckinsey", "accenture",
  "ibm", "microsoft", "amazon", "google", "oracle", "sap",
  "ellisdon", "aecon", "stantec", "wsp", "snc-lavalin", "jacobs",
  "golder", "hatch",
];

const CHAMPION_TITLES_SRV = "proposal OR proposals OR bid OR bidding OR \"business development\" OR grants OR procurement OR contracts OR \"capture manager\" OR \"pursuit manager\"";
const CHAMPION_TITLES_GD = "sales OR estimat OR contracts OR procurement OR \"business development\" OR \"account manager\" OR \"supply chain\"";
const CHAMPION_TITLES_CNST = "estimat OR \"project manager\" OR \"business development\" OR procurement OR contracts OR \"preconstruction\" OR bid OR tender";

const DECISION_TITLES = "owner OR founder OR CEO OR president OR \"managing director\" OR COO OR CFO OR \"vice president\" OR VP OR director OR \"general manager\" OR \"executive director\"";

function normalizeProvince(p) {
  if (!p) return "";
  const map = {
    on: "Ontario", ontario: "Ontario",
    qc: "Quebec", quebec: "Quebec", québec: "Quebec",
    bc: "British Columbia", "british columbia": "British Columbia",
    ab: "Alberta", alberta: "Alberta",
    mb: "Manitoba", manitoba: "Manitoba",
    sk: "Saskatchewan", saskatchewan: "Saskatchewan",
    ns: "Nova Scotia", "nova scotia": "Nova Scotia",
    nb: "New Brunswick", "new brunswick": "New Brunswick",
    nl: "Newfoundland and Labrador", "newfoundland and labrador": "Newfoundland and Labrador",
    pe: "Prince Edward Island", "prince edward island": "Prince Edward Island", pei: "Prince Edward Island",
    nt: "Northwest Territories", "northwest territories": "Northwest Territories",
    nu: "Nunavut", nunavut: "Nunavut",
    yt: "Yukon", yukon: "Yukon",
  };
  return map[p.toLowerCase().trim()] || p.trim();
}

function normalizeCompanyName(name) {
  if (!name) return "";
  return name
    .replace(/\s+(inc\.?|ltd\.?|llc\.?|corp\.?|co\.?|limited|incorporated|corporation)$/i, "")
    .replace(/[.,]+$/, "")
    .trim();
}

function fuzzyMatch(a, b) {
  const na = normalizeCompanyName(a).toLowerCase();
  const nb = normalizeCompanyName(b).toLowerCase();
  if (na === nb) return true;
  if (na.length < 3 || nb.length < 3) return na === nb;
  const shorter = na.length < nb.length ? na : nb;
  const longer = na.length < nb.length ? nb : na;
  return longer.includes(shorter) && shorter.length / longer.length > 0.7;
}

function isCanadian(country) {
  if (!country) return true; // assume Canadian if missing
  return CANADIAN_COUNTRIES.includes(country.toLowerCase().trim());
}

function isExcludedOrg(name) {
  const lower = name.toLowerCase();
  return EXCLUDE_KEYWORDS.some(k => lower.includes(k));
}

function isLargeCorp(name) {
  const lower = name.toLowerCase();
  return LARGE_CORP_KEYWORDS.some(k => lower.includes(k));
}

function getCategory(cat) {
  if (!cat) return "unknown";
  const c = cat.replace(/\*/g, "").replace(/\n/g, "").trim().toUpperCase();
  if (c.includes("SRV") && c.includes("GD")) return "services_goods";
  if (c.includes("SRV")) return "services";
  if (c.includes("GD")) return "goods";
  if (c.includes("CNST")) return "construction";
  return "other";
}

function scoreCompany(company) {
  let score = 50;
  let reasons = [];

  if (!isCanadian(company.country)) { score -= 40; reasons.push("Non-Canadian"); }
  if (isExcludedOrg(company.name)) { score -= 30; reasons.push("Excluded org type"); }
  if (isLargeCorp(company.name)) { score -= 20; reasons.push("Large corp"); }

  // Prefer services
  if (company.category === "services") { score += 15; reasons.push("Services"); }
  else if (company.category === "construction") { score += 5; reasons.push("Construction"); }

  // Contract size sweet spot ($10K - $2M)
  const amt = company.totalAmount;
  if (amt > 10000 && amt <= 500000) { score += 15; reasons.push("SMB contract size"); }
  else if (amt > 500000 && amt <= 2000000) { score += 10; reasons.push("Mid contract size"); }
  else if (amt > 2000000) { score -= 5; reasons.push("Large contract"); }
  else if (amt === 0 || amt === 1) { score += 0; reasons.push("No amount listed"); }

  // Province bonus for Atlantic Canada
  if (["Nova Scotia", "New Brunswick", "Prince Edward Island", "Newfoundland and Labrador"].includes(company.province)) {
    score += 5; reasons.push("Atlantic Canada");
  }

  score = Math.max(0, Math.min(100, score));
  let tier = score >= 70 ? "high" : score >= 45 ? "medium" : "low";
  return { score, tier, reasons };
}

function getChampionTitles(category) {
  if (category === "construction") return CHAMPION_TITLES_CNST;
  if (category === "goods") return CHAMPION_TITLES_GD;
  return CHAMPION_TITLES_SRV;
}

function buildLinkedInPeopleSearch(companyName, titles) {
  const q = encodeURIComponent(`"${companyName}" ${titles}`);
  return `https://www.linkedin.com/search/results/people/?keywords=${q}`;
}

function buildLinkedInCompanySearch(companyName) {
  const q = encodeURIComponent(companyName);
  return `https://www.linkedin.com/search/results/companies/?keywords=${q}`;
}

function buildGoogleContactSearch(companyName, city, province) {
  const loc = [city, province].filter(Boolean).join(" ");
  const q = encodeURIComponent(`"${companyName}" ${loc} contact OR about OR team`);
  return `https://www.google.com/search?q=${q}`;
}

function buildGoogleProcurementSearch(companyName) {
  const q = encodeURIComponent(`"${companyName}" tender OR grant OR RFP OR contract OR procurement`);
  return `https://www.google.com/search?q=${q}`;
}

function buildGoogleWebsiteSearch(companyName, city) {
  const q = encodeURIComponent(`"${companyName}" ${city || ""}`);
  return `https://www.google.com/search?q=${q}`;
}

// ── CSV parsing ──────────────────────────────────────────────────────
function parseCSV(text) {
  const lines = [];
  let current = "";
  let inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (ch === '"') {
      if (inQuotes && text[i + 1] === '"') { current += '"'; i++; }
      else { inQuotes = !inQuotes; }
    } else if ((ch === "," || ch === "\n" || ch === "\r") && !inQuotes) {
      if (ch === ",") {
        lines.length === 0
          ? (lines.push([current]), (current = ""))
          : (lines[lines.length - 1].push(current), (current = ""));
      } else {
        if (ch === "\r" && text[i + 1] === "\n") i++;
        if (current || (lines.length > 0 && lines[lines.length - 1])) {
          if (lines.length === 0) lines.push([current]);
          else lines[lines.length - 1].push(current);
          current = "";
          lines.push([]);
        }
      }
    } else {
      current += ch;
    }
  }
  if (current) {
    if (lines.length === 0) lines.push([current]);
    else lines[lines.length - 1].push(current);
  }

  if (lines.length < 2) return [];
  const headers = lines[0].map(h => h.replace(/^\uFEFF/, "").trim());
  const rows = [];
  for (let i = 1; i < lines.length; i++) {
    if (lines[i].length < 2) continue;
    const row = {};
    headers.forEach((h, idx) => { row[h] = (lines[i][idx] || "").trim(); });
    rows.push(row);
  }
  return rows;
}

function getField(row, ...partials) {
  for (const key of Object.keys(row)) {
    const lk = key.toLowerCase();
    if (partials.some(p => lk.includes(p.toLowerCase()))) return row[key];
  }
  return "";
}

function processRows(rawRows) {
  const companyMap = new Map();

  for (const row of rawRows) {
    const name = getField(row, "supplierLegalName") || "";
    if (!name) continue;

    const city = getField(row, "supplierAddressCity") || "";
    const province = normalizeProvince(getField(row, "supplierAddressProvince"));
    const country = getField(row, "supplierAddressCountry") || "";
    const category = getCategory(getField(row, "procurementCategory"));
    const entity = getField(row, "contractingEntityName") || "";
    const awardDate = getField(row, "contractAwardDate") || "";
    const description = getField(row, "awardDescription-descriptionAttribution-eng") || getField(row, "awardDescription") || "";

    let amount = 0;
    try { amount = parseFloat((getField(row, "contractAmount") || "0").replace(/,/g, "")) || 0; } catch {}

    // Find existing or create new
    let existing = null;
    for (const [key, comp] of companyMap) {
      if (fuzzyMatch(key, name)) { existing = comp; break; }
    }

    const contract = { amount, entity, awardDate, category, description: description.substring(0, 200) };

    if (existing) {
      existing.contracts.push(contract);
      existing.totalAmount += amount;
      existing.contractCount++;
      if (!existing.categories.includes(category)) existing.categories.push(category);
    } else {
      companyMap.set(name, {
        name,
        city,
        province,
        country,
        category,
        categories: [category],
        contracts: [contract],
        totalAmount: amount,
        contractCount: 1,
      });
    }
  }

  return Array.from(companyMap.values()).map(c => {
    const { score, tier, reasons } = scoreCompany(c);
    return { ...c, score, tier, reasons, id: Math.random().toString(36).substr(2, 9) };
  });
}

