# Copy to .env and fill in the keys you have. Free connectors need nothing here.
# Paid connectors turn ON automatically once their key is present.

# --- Identity resolution (paid) ---
# Pipl — investigations-gated, ~$0.10+/matched query
PIPL_API_KEY=
# People Data Labs — ~$0.20-0.28/match, $98/mo Pro
PDL_API_KEY=

# --- Corporate (paid) ---
# OpenCorporates — officer search, from ~GBP2,250/yr
OPENCORPORATES_API_TOKEN=

# --- Sanctions / PEP ---
# OpenSanctions — set a hosted key (free for non-commercial, metered for commercial)...
OPENSANCTIONS_API_KEY=
# ...OR point at your own self-hosted yente instance (free) and leave the key blank:
OPENSANCTIONS_BASE_URL=
# ComplyAdvantage — PEP + NLP adverse media, from ~$99/mo
COMPLYADVANTAGE_API_KEY=

# --- Consent-based criminal check (paid) ---
# Certn — CPIC criminal check, $24.99-29.99 CAD/check, REQUIRES subject consent
CERTN_API_KEY=

# --- Free watchlist screening (no key needed) ---
# Add extra free sanctions/PEP feeds as "label|url|parser" separated by ";"
# parser is one of: ofac_sdn | un | csv   (US OFAC + UN ship on by default)
OSINT_WATCHLIST_FEEDS=
# Name-match sensitivity 0-1 (higher = fewer, stricter matches). Default 0.86
OSINT_WATCHLIST_THRESHOLD=

# --- Behaviour ---
OSINT_HTTP_TIMEOUT=20
# Identify yourself politely to free public APIs:
OSINT_USER_AGENT=osint-dossier/1.0 (+your-contact@example.com)
