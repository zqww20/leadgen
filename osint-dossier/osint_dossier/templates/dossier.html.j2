<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Dossier {{ d.case_id }} — {{ d.subject.name }}</title>
<style>
  :root { --bg:#0f1115; --card:#181b22; --line:#2a2f3a; --txt:#e6e8ec; --mut:#9aa3b2; --accent:#5b9dff; --warn:#ff6b6b; }
  * { box-sizing:border-box; }
  body { margin:0; font:15px/1.5 -apple-system,Segoe UI,Roboto,sans-serif; background:var(--bg); color:var(--txt); }
  .wrap { max-width:920px; margin:0 auto; padding:32px 20px 80px; }
  header { border-bottom:1px solid var(--line); padding-bottom:18px; margin-bottom:24px; }
  h1 { margin:0 0 6px; font-size:26px; }
  .meta { color:var(--mut); font-size:13px; }
  .basis { margin-top:12px; padding:10px 14px; background:#20242e; border-left:3px solid var(--accent); border-radius:4px; font-size:13px; }
  .stats { display:flex; flex-wrap:wrap; gap:10px; margin:20px 0; }
  .stat { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:10px 16px; }
  .stat b { font-size:20px; display:block; }
  .stat span { color:var(--mut); font-size:12px; }
  section { margin:26px 0; }
  h2 { font-size:15px; text-transform:uppercase; letter-spacing:.5px; color:var(--accent); border-bottom:1px solid var(--line); padding-bottom:8px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:8px; padding:14px 16px; margin:10px 0; }
  .card.warn { border-color:var(--warn); }
  .card .t { font-weight:600; }
  .card .s { color:var(--mut); font-size:13px; margin:4px 0; }
  .card a { color:var(--accent); font-size:12px; word-break:break-all; }
  .src { float:right; font-size:11px; color:var(--mut); text-transform:uppercase; letter-spacing:.5px; }
  .conf { display:inline-block; font-size:10px; padding:1px 7px; border-radius:10px; margin-right:6px; text-transform:uppercase; letter-spacing:.4px; }
  .conf.confirmed { background:#1f6f43; } .conf.possible { background:#7a5a12; } .conf.unverified { background:#333a47; color:var(--mut); }
  .kv { font-family:ui-monospace,monospace; font-size:12px; color:var(--mut); margin-top:6px; white-space:pre-wrap; }
  .err { color:var(--warn); font-size:13px; }
  footer { margin-top:50px; color:var(--mut); font-size:11px; border-top:1px solid var(--line); padding-top:16px; }
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>{{ d.subject.name }}</h1>
    <div class="meta">
      Case <b>{{ d.case_id }}</b> · generated {{ d.created_at }} · operator: {{ d.operator }}
      {% if d.subject.location %}· {{ d.subject.location }}{% endif %}
    </div>
    <div class="basis"><b>Lawful basis:</b> {{ d.lawful_basis }}</div>
  </header>

  <div class="stats">
    <div class="stat"><b>{{ d.findings|length }}</b><span>findings</span></div>
    <div class="stat"><b>{{ d.connectors_run|length }}</b><span>sources run</span></div>
    <div class="stat"><b>{{ d.errors|length }}</b><span>errors</span></div>
  </div>

  {% for cat in categories %}
    {% set items = grouped.get(cat, []) %}
    {% if items %}
    <section>
      <h2>{{ labels[cat] }} <span style="color:var(--mut)">({{ items|length }})</span></h2>
      {% for f in items %}
        {% set adverse = f.data.get('adverse_terms') %}
        <div class="card {{ 'warn' if adverse or f.confidence == 'possible' else '' }}">
          <span class="src">{{ f.source }}</span>
          <div class="t"><span class="conf {{ f.confidence }}">{{ f.confidence }}</span>{{ f.title }}</div>
          {% if f.summary %}<div class="s">{{ f.summary }}</div>{% endif %}
          {% if f.url %}<a href="{{ f.url }}" target="_blank" rel="noopener">{{ f.url }}</a>{% endif %}
          {% if f.data and cat != 'manual' %}<div class="kv">{{ f.data | tojson(indent=None) }}</div>{% endif %}
        </div>
      {% endfor %}
    </section>
    {% endif %}
  {% endfor %}

  {% if d.errors %}
  <section>
    <h2>Source Errors</h2>
    {% for e in d.errors %}<div class="err">{{ e.source }}: {{ e.message }}</div>{% endfor %}
  </section>
  {% endif %}

  <footer>
    Generated by osint-dossier. Findings are unverified leads from third-party sources —
    corroborate before relying on them. Handle this file under your PIPEDA obligations:
    minimize, secure, and delete per your retention policy.
  </footer>
</div>
</body>
</html>
